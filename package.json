{
  "name": "iot_farm_monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "IoT Smart Farm Monorepo with React Frontend, FastAPI Backend, InfluxDB 3 and Jetson Nano edge agent",
  "scripts": {
    "dev": "npx -y concurrently -n \"FRONTEND,BACKEND\" -c \"cyan.bold,green.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "node scripts/run-backend.js",
    "build:frontend": "cd frontend && npm run build",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "influx:up": "docker compose up -d",
    "influx:down": "docker compose down",
    "influx:seed": "cd backend && node ../scripts/run-python.js -m scripts.seed_influx",
    "train": "cd backend && node ../scripts/run-python.js -m app.ml.train"
  },
  "keywords": [
    "iot",
    "fastapi",
    "react",
    "gemini-ai",
    "smart-farm",
    "influxdb",
    "forecasting"
  ],
  "author": "UIT",
  "license": "MIT"
}
