# =====================================================================
# IoT Farm Backend - cấu hình môi trường (copy file này thành .env)
# =====================================================================

# ---------- Google Gemini AI (tùy chọn) ----------
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Mô hình Gemini (khuyến nghị gemini-2.5-flash để tốc độ nhanh nhất)
GEMINI_MODEL="gemini-2.5-flash"

# ---------- Server ----------
PORT=8000
HOST="0.0.0.0"

# ---------- Firebase Realtime Database ----------
FIREBASE_DB_URL="https://iot-farm-chilli-default-rtdb.asia-southeast1.firebasedatabase.app"
# Cách 1 (khuyến nghị): Service Account (Firebase Console > Project settings > Service accounts
#   > Generate new private key) -> lưu file vào backend/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT="secrets/firebase-service-account.json"
# Cách 2 (nếu không dùng service account): tài khoản Firebase Auth email/password + Web API Key
FIREBASE_API_KEY=""
FIREBASE_AUTH_EMAIL=""
FIREBASE_AUTH_PASSWORD=""
# ID thiết bị Jetson Nano (trùng với edge/config.ini)
DEVICE_ID="jetson-nano-01"

# ---------- InfluxDB 3 Core (docker compose up -d) ----------
INFLUX_URL="http://localhost:18181"
INFLUX_DB="iot_farm"
# Để trống khi chạy --without-auth (mặc định trong docker-compose.yml)
INFLUX_TOKEN=""

# ---------- Đồng bộ Firebase <-> InfluxDB ----------
SYNC_ENABLED=true
# Chu kỳ đồng bộ nhanh Firebase -> InfluxDB (hôm nay + hôm qua), giây
SYNC_INTERVAL_SEC=60
# Chu kỳ đối chiếu toàn bộ 2 chiều (audit + backfill), giây
SYNC_AUDIT_INTERVAL_SEC=1800
# Số ngày gần nhất được đối chiếu (0 = tất cả)
SYNC_AUDIT_DAYS=30
# Bù dữ liệu InfluxDB -> Firebase khi Firebase bị thiếu
BACKFILL_TO_FIREBASE=true
# Chỉ backfill N ngày gần nhất (0 = tất cả)
BACKFILL_DAYS=7
# Ghi cả các lần đồng bộ "không có gì mới" lên Firebase logs/sync (mặc định tắt để tránh spam)
SYNC_LOG_NOOP_TO_FIREBASE=false

# ---------- Vị trí vườn & thời tiết (Open-Meteo, không cần API key) ----------
FARM_LAT=10.843322589355028
FARM_LON=106.83888868895238
FARM_TZ="Asia/Ho_Chi_Minh"
WEATHER_FORECAST_TTL_SEC=1800

# ---------- Dữ liệu / Cache ----------
CACHE_DIR="app/cache"
SOIL_JSON_PATH="../frontend/public/soil_all.json"

# ---------- Mô hình dự báo (xem docs/MODELS.md) ----------
# auto = InfluxDB nếu có >= 7 ngày dữ liệu, ngược lại dùng soil_all.json
ML_DATA_SOURCE="auto"
# Thiết bị huấn luyện/suy luận: auto (GPU nếu có) | cuda | cpu
ML_DEVICE="auto"
# Thời gian cache kết quả dự báo (giây)
ML_FORECAST_CACHE_SEC=300
# Mô hình nền tảng Chronos-Bolt (HuggingFace)
ML_CHRONOS_MODEL="amazon/chronos-bolt-small"
# Dùng biến thời tiết Open-Meteo cho nhóm dự báo dài hạn (1 = có)
ML_USE_WEATHER=1
# Thư mục lưu mô hình / metrics (mặc định backend/artifacts), cache HuggingFace (mặc định artifacts/hf_cache)
# ML_ARTIFACTS_DIR="artifacts"
# HF_HOME="artifacts/hf_cache"
